/-- Check of one row `(r, A, g)`. -/
def rowOK (x : ℕ × ℕ × ℕ) : Bool :=
  decide (3 ^ x.1 + 1 < 2 ^ x.2.1) && decide (2 ^ x.2.1 ≤ 2 * 3 ^ x.1) &&
  (Nat.gcd x.2.1 x.1 != 1 ||
    (x.2.2 ^ x.1 % (2 ^ x.2.1 - 3 ^ x.1) == 2 && x.2.2 ^ x.2.1 % (2 ^ x.2.1 - 3 ^ x.1) == 3 &&
     (List.range x.1).all (fun p => decide (p < 1) || decide (x.1 ≤ p + 1) ||
        x.2.2 ^ p % (2 ^ x.2.1 - 3 ^ x.1) !=
          (x.2.2 ^ (p + 1) % (2 ^ x.2.1 - 3 ^ x.1) + 1) % (2 ^ x.2.1 - 3 ^ x.1)) &&
     (List.range x.1).all (fun e => decide (e < 2) ||
        x.2.2 % (2 ^ x.2.1 - 3 ^ x.1) !=
          (x.2.2 ^ e % (2 ^ x.2.1 - 3 ^ x.1) + 1) % (2 ^ x.2.1 - 3 ^ x.1))))

/-- The whole table is correct and covers `3 ≤ r < 150`. -/
def tblOK : Bool :=
  tbl.all rowOK && (List.range 150).all (fun r => decide (r < 3) || tbl.any (fun x => x.1 == r))

theorem tblOK_eq : tblOK = true := by decide +kernel

theorem window_unique {r A A' : ℕ} (h1 : 3 ^ r + 1 < 2 ^ A) (h2 : 2 ^ A ≤ 2 * 3 ^ r)
    (h1' : 3 ^ r + 1 < 2 ^ A') (h2' : 2 ^ A' ≤ 2 * 3 ^ r) : A = A' := by
  by_contra hne
  rcases Nat.lt_or_gt_of_ne hne with h | h
  · have : 2 ^ (A + 1) ≤ 2 ^ A' := Nat.pow_le_pow_right (by norm_num) h
    rw [pow_succ] at this; omega
  · have : 2 ^ (A' + 1) ≤ 2 ^ A := Nat.pow_le_pow_right (by norm_num) h
    rw [pow_succ] at this; omega

theorem cast_pow_mod {q g n : ℕ} : ((g ^ n % q : ℕ) : ZMod q) = (g : ZMod q) ^ n := by
  rw [ZMod.natCast_mod]; push_cast; rfl

/-- **Finite range `3 ≤ r < 150`** (kernel-checked table). -/
theorem finite_check {r A : ℕ} (hr3 : 3 ≤ r) (hr : r < 150) (hq : 3 ^ r + 1 < 2 ^ A)
    (hA2 : 2 ^ A ≤ 2 * 3 ^ r) (hcop : Nat.Coprime A r) {g : ZMod (2 ^ A - 3 ^ r)}
    (h2 : g ^ r = 2) (h3 : g ^ A = 3) :
    (∀ p, 1 ≤ p → p + 1 < r → g ^ (p + 1) - g ^ p + 1 ≠ 0) ∧
    (∀ e, 2 ≤ e → e < r → g ^ e - g + 1 ≠ 0) := by
  have hT := tblOK_eq
  simp only [tblOK, Bool.and_eq_true, List.all_eq_true, Bool.or_eq_true, decide_eq_true_eq,
    List.any_eq_true, beq_iff_eq, List.mem_range] at hT
  obtain ⟨x, hx, hxr⟩ := (hT.2 r hr).resolve_left (by omega)
  have hrow := hT.1 x hx
  obtain ⟨r', A', g'⟩ := x
  simp only at hxr
  subst hxr
  simp only [rowOK, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq,
    beq_iff_eq, List.all_eq_true, List.mem_range] at hrow
  obtain ⟨⟨hw1, hw2⟩, hrest⟩ := hrow
  have hAA := window_unique hq hA2 hw1 hw2
  subst hAA
  have hgcd : Nat.gcd A r' = 1 := hcop
  have hrest := hrest.resolve_left (by simp [hgcd])
  obtain ⟨⟨⟨hg2, hg3⟩, hI⟩, hII⟩ := hrest
  have e2 : (g' : ZMod (2 ^ A - 3 ^ r')) ^ r' = 2 := by
    rw [← cast_pow_mod, hg2]; norm_num
  have e3 : (g' : ZMod (2 ^ A - 3 ^ r')) ^ A = 3 := by
    rw [← cast_pow_mod, hg3]; norm_num
  have hgg := g_unique (by omega) hcop hq h2 h3 e2 e3
  subst hgg
  constructor
  · intro p hp hpr hzero
    have := hI p (by omega)
    apply this.resolve_left (by omega)
    have h' : ((g' ^ p : ℕ) : ZMod (2 ^ A - 3 ^ r')) = ((g' ^ (p + 1) + 1 : ℕ) : ZMod _) := by
      push_cast; linear_combination -hzero
    rw [ZMod.natCast_eq_natCast_iff'] at h'
    rw [h', Nat.mod_add_mod]
  · intro e he her hzero
    have := hII e (by omega)
    apply this.resolve_left (by omega)
    have h' : ((g' : ℕ) : ZMod (2 ^ A - 3 ^ r')) = ((g' ^ e + 1 : ℕ) : ZMod _) := by
      push_cast; linear_combination -hzero
    rw [ZMod.natCast_eq_natCast_iff'] at h'
    rw [h', Nat.mod_add_mod]

